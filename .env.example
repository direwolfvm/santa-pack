# Copy to .env for local development (npm run dev loads it).
# Production reads these from Cloud Run env vars and Secret Manager (see README Deploy).

# Which backend to run: supabase (current production, the default) or firebase.
BACKEND=supabase
PORT=8080

# --- BACKEND=supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- BACKEND=firebase ---
# All public values: the Firebase web config is safe to ship to browsers.
GOOGLE_CLOUD_PROJECT=hopeful-machine-466912-t2
FIRESTORE_DATABASE=santa-pack
FIREBASE_TENANT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=hopeful-machine-466912-t2.firebaseapp.com
APP_BASE_URL=http://localhost:8080
APP_ADDITIONAL_ORIGINS=

# Optional: send the sign-in emails through Mailgun (all three, or none).
# Without them the emulators print each email to the server log, and a real
# tenant falls back to Google's emails. The key is private: Secret Manager in production.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=
MAILGUN_API_BASE_URL=https://api.mailgun.net
# true: Mailgun accepts the message but doesn't deliver it.
MAILGUN_TEST_MODE=false
