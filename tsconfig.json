{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["es2023", "dom", "dom.iterable"]
  },
  "include": [
    "server/**/*.js",
    "tests/**/*.js",
    "scripts/**/*.mjs",
    "app/src/**/*.js",
    "*.config.js",
    "app/src/**/*.d.ts"
  ]
}
